# Kopiraj ovu datoteku u .env i upiši prave vrijednosti.
# .env se NIKAD ne šalje u Git.

DEBUG=True
SECRET_KEY=promijeni-me
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Petar, produkcija):
DATABASE_URL=postgres://vjecnaspomen:PROMIJENI_ME@localhost:5432/vjecnaspomen
# SQLite (dovoljno za rad na predlošcima, ne treba ništa instalirati):
# DATABASE_URL=sqlite:///db.sqlite3

# Početak linka u QR kodu (velika slova). Lokalno: IP računala (macOS: ipconfig getifaddr en0).
QR_BAZNI_URL=HTTP://192.168.1.20:8000/G/

# True samo na hostingu (aplikacija je iza proxyja, IP posjetitelja je u X-Forwarded-For).
IZA_PROXYJA=False
# Koliko posrednika stoji ispred aplikacije na hostingu (gleda se samo uz IZA_PROXYJA=True).
PROXY_BROJ_POSREDNIKA=1

# E-mail. Bez EMAIL_HOST poruke se samo ispisuju u terminal (dovoljno za razvoj).
DEFAULT_FROM_EMAIL=Vječna spomen <noreply@localhost>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
